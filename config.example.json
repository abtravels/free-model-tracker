{
  "discordWebhook": "${DISCORD_WEBHOOK}",
  "intervalMinutes": 15,
  "freeOnly": true,
  "onlyUncensored": false,
  "maxEmbedsPerMessage": 10,
  "verify": {
    "enabled": true,
    "maxTokens": 8,
    "timeoutMs": 75000,
    "concurrency": 4,
    "maxProbesPerRun": 12
  },
  "statePath": "data/seen.json",
  "uncensoredKeywords": [
    "uncensored",
    "abliterated",
    "heretic",
    "unaligned",
    "unfiltered",
    "dolphin",
    "nsfw"
  ],
  "quietHours": null,
  "discovery": {
    "enabled": false,
    "minStars": 2,
    "maxAgeDays": 45,
    "githubQueries": [
      { "label": "free LLM API", "q": "free llm api in:name,description" },
      { "label": "openai-compatible gateway", "q": "openai compatible free in:name,description" },
      { "label": "uncensored model api", "q": "uncensored abliterated api in:name,description,readme" },
      { "label": "free api key list", "q": "\"free api key\" llm in:readme" }
    ]
  },
  "sources": [
    {
      "id": "numes",
      "name": "Numes",
      "modelsUrl": "https://api.numes.ai/api/v1/models",
      "modelUrl": "https://numes.ai/models/{id}",
      "home": "https://numes.ai/models",
      "headers": { "Authorization": "Bearer ${NUMES_KEY}" }
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "modelsUrl": "https://openrouter.ai/api/v1/models",
      "modelUrl": "https://openrouter.ai/{id}",
      "home": "https://openrouter.ai/models",
      "headers": { "Authorization": "Bearer ${OPENROUTER_KEY}" }
    },
    {
      "id": "zenmux",
      "name": "ZenMux",
      "modelsUrl": "https://zenmux.ai/api/v1/models",
      "home": "https://zenmux.ai/models",
      "headers": { "Authorization": "Bearer ${ZENMUX_KEY}" }
    },
    {
      "id": "crowllm",
      "name": "CrowLLM",
      "modelsUrl": "https://crowllm.com/v1/models",
      "home": "https://crowllm.com",
      "headers": { "Authorization": "Bearer ${CROWLLM_KEY}" }
    },
    {
      "id": "apinex",
      "name": "APInex",
      "modelsUrl": "https://api.apinex.bond/v1/models",
      "home": "https://apinex.bond",
      "headers": { "Authorization": "Bearer ${APINEX_KEY}" }
    },
    {
      "id": "bitllm",
      "name": "BitLLM (local)",
      "modelsUrl": "http://127.0.0.1:7778/v1/models",
      "headers": { "Authorization": "Bearer bitllm" }
    },
    {
      "id": "uncensoredllm",
      "name": "UncensoredLLM (free, public key)",
      "modelsUrl": "https://uncensored-llm.sbs/v1/models",
      "modelUrl": "https://uncensored-llm.sbs",
      "home": "https://uncensored-llm.sbs/",
      "freeAssumed": true,
      "headers": { "Authorization": "Bearer ${UNCENSOREDLLM_KEY}" }
    },
    {
      "id": "pollinations",
      "name": "Pollinations (anonymous, free)",
      "modelsUrl": "https://text.pollinations.ai/models",
      "chatUrl": "https://text.pollinations.ai/openai",
      "modelUrl": "https://pollinations.ai/",
      "home": "https://pollinations.ai/",
      "freeAssumed": true
    },
    {
      "id": "abliteratedmodels",
      "name": "Abliterated Models (free key, uncensored)",
      "modelsUrl": "https://api.abliteratedmodels.cc/v1/models",
      "modelUrl": "https://abliteratedmodels.cc/models/{id}",
      "home": "https://abliteratedmodels.cc/",
      "headers": { "Authorization": "Bearer ${ABLITERATED_KEY}" }
    },
    {
      "id": "deepinfra",
      "name": "DeepInfra (key, trial/paid tier)",
      "modelsUrl": "https://api.deepinfra.com/v1/openai/models",
      "modelUrl": "https://deepinfra.com/models/{id}",
      "home": "https://deepinfra.com/",
      "headers": { "Authorization": "Bearer ${DEEPINFRA_KEY}" }
    }
  ]
}
